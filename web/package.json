{
  "name": "intent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "description": "Web demo for the Intent chord input system.",
  "scripts": {
    "wasm": "wasm-pack build ../crates/intent-wasm --target web --out-dir ../../web/src/wasm --out-name intent --no-pack",
    "dev": "pnpm wasm && vite",
    "build": "pnpm wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "^5.3.0"
  }
}
